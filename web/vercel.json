{
  "framework": "vite",
  "installCommand": "npm install --no-package-lock",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://watch-space.onrender.com/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
